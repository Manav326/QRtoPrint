{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartPrint by QuantaEdge",
  "version": "0.1.0",
  "identifier": "in.thinkwithsujeet.smartprint",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SmartPrint by QuantaEdge",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost http://tauri.localhost; img-src 'self' asset: http://asset.localhost http://tauri.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://tauri.localhost https: http://127.0.0.1:17842"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}