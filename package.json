{
  "name": "smart-print",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm --filter @smart-print/portal dev",
    "build": "pnpm --filter @smart-print/portal build",
    "typecheck": "pnpm --filter @smart-print/portal typecheck",
    "desktop:dev": "pnpm --filter @smart-print/desktop tauri dev",
    "desktop:build": "pnpm --filter @smart-print/desktop tauri build",
    "desktop:typecheck": "pnpm --filter @smart-print/desktop typecheck"
  }
}
