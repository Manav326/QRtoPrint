{
  "name": "smartprint",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm --filter @smartprint/portal dev",
    "build": "pnpm --filter @smartprint/portal build",
    "typecheck": "pnpm --filter @smartprint/portal typecheck",
    "desktop:dev": "pnpm --filter @smartprint/desktop tauri dev",
    "desktop:build": "pnpm --filter @smartprint/desktop tauri build",
    "desktop:typecheck": "pnpm --filter @smartprint/desktop typecheck"
  }
}
